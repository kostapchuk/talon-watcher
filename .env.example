# Скопируй в .env и заполни:  cp .env.example .env
#
# Это настройки проверялки (check.py). Бот на Cloudflare Workers настраивается
# отдельно, своими переменными в панели — см. bot/worker.js и README.

# --- рассылка через бота (основной путь) ---------------------------------
# Адрес воркера и общий с ним секрет
BOT_URL=https://<воркер>.workers.dev
BROADCAST_SECRET=<та же строка, что в переменных воркера>

# Кому жаловаться, если talon.by не открывается несколько проверок подряд
OWNER_CHAT_ID=123456789

# --- запасной путь -------------------------------------------------------
# Если BOT_URL не задан, check.py берёт ссылки из WATCH_URLS и шлёт всё в этот
# чат напрямую — удобно для локальной отладки без бота.
TELEGRAM_BOT_TOKEN=123456789:AAAA-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
TELEGRAM_CHAT_ID=123456789
WATCH_URLS=https://talon.by/policlinic/klinika-merci/doctors/89829

# --- необязательное ------------------------------------------------------
# Отчёт владельцу о каждой проверке:
#   edit  — бот держит одно сообщение и переписывает в нём время (по умолчанию;
#           закрепи его в чате — всегда видно, когда была последняя проверка)
#   every — отдельное сообщение на каждую проверку (при расписании раз в 10 минут
#           это ~144 сообщения в сутки)
#   off   — не отчитываться
HEARTBEAT=edit

# Часовой пояс для времени в отчёте (по умолчанию UTC+3, Минск)
REPORT_UTC_OFFSET=3
